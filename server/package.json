{
  "name": "@camera.ui/server",
  "version": "2.4.9",
  "description": "camera.ui server",
  "author": "seydx (https://github.com/cameraui/camera.ui)",
  "type": "module",
  "main": "dist/server/bin/cameraui-server.js",
  "bin": {
    "cameraui-server": "dist/server/bin/cameraui-server.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "@seydx/node-pty": true,
    "fsevents": true,
    "lmdb": true,
    "msgpackr-extract": true,
    "node-av": true,
    "protobufjs": true,
    "@google/genai": true,
    "@openrouter/sdk": true
  },
  "scripts": {
    "build": "npm run build:server && npm run copy:files && node scripts/build-docs.mjs",
    "build:server": "rimraf dist/server && tsc && mypy src",
    "check": "tsc --noEmit && node ../scripts/check-imports.mjs server",
    "copy:files": "cpy package.json dist/server && cpy requirements.txt dist/server && cpy 'src/**/*.py' dist/server/src --parents",
    "format": "prettier --write 'src/' 'bin/' --ignore-unknown --no-error-on-unmatched-pattern && ruff format",
    "install-updates": "npm i --save --legacy-peer-deps",
    "lint": "eslint --fix . && ruff check --fix && mypy --config-file ./mypy.ini src",
    "update": "updates -M npm,pypi,go,cargo,docker --update ./ && cupdate",
    "prepublishOnly": "npm i --package-lock-only && node ../scripts/check-imports.mjs server && npm --prefix .. run check:sensors && npm run lint && npm run format && npm run build && npm --prefix ../ui run lint && npm --prefix ../ui run format && npm --prefix ../ui run build",
    "prepack": "node ../scripts/shrinkwrap.mjs create",
    "postpack": "node ../scripts/shrinkwrap.mjs cleanup",
    "publish:dev": "npm publish --tag dev"
  },
  "dependencies": {
    "@bjia56/portable-python": "^0.1.176",
    "@camera.ui/cloudflared": "^2026.10.4",
    "@camera.ui/common": "~0.0.62",
    "@camera.ui/go2rtc": "^1.9.15-cui.8",
    "@camera.ui/nats": "^2.15.3",
    "@camera.ui/rpc": "^1.1.2",
    "@camera.ui/rust-detector": "~0.0.13",
    "@camera.ui/rust-postprocessor": "~0.2.3",
    "@camera.ui/sdk": "~1.4.8",
    "@camera.ui/tunnel": "^1.1.2",
    "@eneris/push-receiver": "^4.4.0",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/http-proxy": "^11.6.6",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.10",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@homebridge/ciao": "^1.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@peculiar/asn1-schema": "^3.0.0",
    "@peculiar/asn1-x509": "^3.0.0",
    "@peculiar/x509": "1.14.3",
    "@seydx/node-av-ffmpeg": "^7.0.0-beta.3",
    "@seydx/node-pty": "^1.2.0-beta.18",
    "@seydx/win-job": "^0.1.0",
    "@tanstack/ai": "^1.4.0",
    "@tanstack/ai-anthropic": "^1.1.1",
    "@tanstack/ai-compaction": "^1.0.1",
    "@tanstack/ai-gemini": "^1.2.1",
    "@tanstack/ai-memory": "^1.1.0",
    "@tanstack/ai-ollama": "^1.1.1",
    "@tanstack/ai-openai": "^1.1.1",
    "@tanstack/ai-openrouter": "^1.1.2",
    "@tanstack/ai-persistence": "^1.0.1",
    "@tanstack/ai-skills": "^1.0.2",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "adm-zip": "^0.6.1",
    "aedes": "^1.2.0",
    "croner": "^11.0.0",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "fs-extra": "^11.4.1",
    "js-yaml": "^5.5.0",
    "jsonwebtoken": "^9.0.3",
    "lmdb": "^3.5.9",
    "mqtt": "^5.16.1",
    "msgpackr": "^2.1.4",
    "node-av": "^7.0.0-beta.3",
    "qs": "^6.17.1",
    "reflect-metadata": "^0.2.2",
    "semver": "^7.8.6",
    "socket.io": "^4.8.4",
    "systeminformation": "^5.33.19",
    "tar": "^7.5.23",
    "tsyringe": "^4.10.0",
    "undici": "^8.12.4",
    "werift": "^0.27.0",
    "ws": "^8.22.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fastify/formbody": "^9.0.1",
    "@isaacs/ttlcache": "^2.1.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/adm-zip": "^0.5.8",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "26.6.6",
    "@types/node-forge": "^1.3.14",
    "@types/npm-registry-fetch": "^8.0.9",
    "@types/pacote": "^11.1.8",
    "@types/qs": "^6.15.1",
    "@types/semver": "^7.8.0",
    "@types/tail": "^2.2.3",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/parser": "^8.72.2",
    "ansicolor": "^2.0.3",
    "cpy-cli": "^7.0.0",
    "cross-env": "^10.1.0",
    "eslint": "9.39.2",
    "fkill": "^10.0.3",
    "globals": "^17.14.0",
    "node-forge": "^1.4.3",
    "npm-registry-fetch": "^20.0.1",
    "otplib": "^13.6.0",
    "pacote": "^22.0.1",
    "prettier": "^3.10.0",
    "ps-list": "^9.0.0",
    "rimraf": "^6.1.4",
    "tail": "^2.2.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2",
    "updates": "^20.0.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "adm-zip": "$adm-zip",
    "vitest": "$vitest",
    "werift": "$werift"
  },
  "bugs": {
    "url": "https://github.com/cameraui/camera.ui/issues"
  },
  "cameraui": {
    "workerProtocol": {
      "level": 2,
      "min": 2
    }
  },
  "engines": {
    "node": ">=24.5.0"
  },
  "homepage": "https://github.com/cameraui/camera.ui#readme",
  "keywords": [
    "camera.ui",
    "camera",
    "nvr",
    "surveillance",
    "homekit",
    "streaming",
    "webrtc",
    "motion detection",
    "object detection",
    "server"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cameraui/camera.ui.git"
  }
}
