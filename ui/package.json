{
  "name": "@camera.ui/ui",
  "version": "2.0.0",
  "private": true,
  "description": "camera.ui web interface",
  "type": "module",
  "allowScripts": {
    "@parcel/watcher": true,
    "fsevents": true,
    "msgpackr-extract": true,
    "sharp": true,
    "vue-demi": true
  },
  "scripts": {
    "build": "rimraf ../server/dist/interface && npm run type-check && npm run pwa && npm run build:only && npm run build:ha && npm run build:compress",
    "build:compress": "node scripts/precompress.mjs",
    "build:ha": "vite build -c vite.ha.config.ts",
    "build:only": "vite build",
    "build:mobile": "rimraf dist-mobile && npm run type-check && npm run build:mobile:only",
    "build:mobile:only": "cross-env CAMERA_UI_MOBILE=1 vite build",
    "build-electron": "npm run type-check && npm run pwa && npm run build-electron:only",
    "build-electron:only": "cross-env CAMERA_UI_RUNMODE=electron vite build",
    "bundle": "vite-bundle-visualizer --config vite.config.ts --output stats.html",
    "dev": "vite",
    "dev:alt": "CAMERA_UI_PORT=5443 CAMERA_UI_UI_PORT=5100 vite",
    "dev:alt2": "CAMERA_UI_PORT=6443 CAMERA_UI_UI_PORT=6100 vite",
    "dev:alt3": "CAMERA_UI_PORT=7443 CAMERA_UI_UI_PORT=7100 vite",
    "format": "prettier --write src/",
    "install-updates": "npm i --save --legacy-peer-deps",
    "lint": "eslint --fix .",
    "preview": "vite preview",
    "pwa": "pwa-assets-generator",
    "test": "vitest run",
    "type-check": "vue-tsc --build",
    "update": "updates -M npm,pypi,go,cargo,docker,make -u -e eslint,typescript,@eslint/js,vue-tsc"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@camera.ui/browser": "~0.1.3",
    "@camera.ui/common": "~0.0.60",
    "@camera.ui/logger": "~0.0.3",
    "@camera.ui/nvr": "~0.1.5",
    "@camera.ui/rpc": "~1.1.1",
    "@camera.ui/sdk": "~1.4.3",
    "@camera.ui/transport": "~0.1.1",
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/device": "^8.0.3",
    "@capacitor/file-transfer": "^2.0.6",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capawesome/capacitor-badge": "^8.0.4",
    "@capgo/capacitor-updater": "^8.54.0",
    "@iconify/json": "^2.2.547",
    "@openuxkit/styled": "^1.0.0",
    "@openuxkit/utils": "^1.0.1",
    "@openvue/core": "1.0.0",
    "@openvue/icons": "1.0.0",
    "@openvue/themes": "^1.0.0",
    "@tanstack/ai": "^1.0.0",
    "@tanstack/ai-client": "^1.0.0",
    "@tanstack/ai-vue": "^1.0.0",
    "@tanstack/vue-query": "^5.104.5",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vueuse/components": "^15.0.0",
    "@vueuse/core": "^15.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ace-builds": "^1.45.2",
    "axios": "^1.20.0",
    "chart.js": "^4.6.1",
    "compare-versions": "^6.1.1",
    "draggabilly": "^3.0.0",
    "gridstack": "^14.0.0",
    "highlight.js": "^11.12.0",
    "leaflet": "^1.9.4",
    "markdown-it": "^15.0.3",
    "pinia": "^4.1.0",
    "primelocale": "^2.6.1",
    "openvue": "^1.0.0",
    "qrcode": "^1.5.4",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dnd-touch-backend": "^16.0.1",
    "vee-validate": "^5.0.0-beta.1",
    "vue": "^3.5.44",
    "vue-chartjs": "^5.3.4",
    "vue-i18n": "^11.4.16",
    "vue-inline-svg": "^4.0.1",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9",
    "vue-view-transitions": "^1.2.1",
    "vue-zoomable": "^1.2.8",
    "vue3-dnd": "^2.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@openvue/auto-import-resolver": "^1.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "26.6.5",
    "@types/qrcode": "^1.5.6",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "dotenv": "^18.0.9",
    "eslint": "9.39.2",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "sass-embedded": "^1.106.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-primeui": "^0.6.1",
    "tailwindcss-safe-area": "^1.3.0",
    "typescript": "5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^24.0.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-markdown": "32.1.1",
    "updates": "^19.3.0",
    "vite": "8.3.5",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "3.3.11"
  },
  "overrides": {
    "unplugin-vue-markdown": {
      "vite": "$vite"
    },
    "vitest": "$vitest",
    "@vite-pwa/assets-generator": "$@vite-pwa/assets-generator"
  },
  "author": "seydx (https://github.com/cameraui/camera.ui)",
  "license": "MIT",
  "homepage": "https://github.com/cameraui/camera.ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cameraui/camera.ui.git"
  },
  "bugs": {
    "url": "https://github.com/cameraui/camera.ui/issues"
  },
  "keywords": [
    "camera.ui",
    "camera",
    "nvr",
    "surveillance",
    "homekit",
    "streaming",
    "webrtc",
    "motion detection",
    "object detection",
    "ui"
  ]
}
