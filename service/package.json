{
  "name": "camera.ui",
  "version": "2.0.8",
  "description": "camera.ui launcher",
  "type": "module",
  "bin": {
    "cameraui": "./dist/cameraui.js"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "check": "tsc --noEmit && node ../scripts/check-imports.mjs service",
    "format": "prettier --write 'src/' --ignore-unknown --no-error-on-unmatched-pattern",
    "lint": "eslint --fix .",
    "test": "vitest run --passWithNoTests",
    "install-updates": "npm i --save",
    "prepublishOnly": "npm i --package-lock-only && node ../scripts/check-imports.mjs service && npm run lint && npm run format && npm run build",
    "prepack": "node ../scripts/shrinkwrap.mjs create",
    "postpack": "node ../scripts/shrinkwrap.mjs cleanup",
    "update": "updates -M npm,pypi,go,cargo,docker,make --update ./",
    "watch": "nodemon src/cameraui.ts -H ../.camera.ui run",
    "watch:alt": "CAMERA_UI_PORT=5443 nodemon src/cameraui.ts -H ../.camera.ui.alt run",
    "watch:alt2": "CAMERA_UI_PORT=6443 nodemon src/cameraui.ts --worker -H ../.camera.ui.alt.2 run"
  },
  "dependencies": {
    "@camera.ui/common": "~0.0.58-beta.2",
    "commander": "^15.0.0",
    "js-yaml": "^5.4.2",
    "systeminformation": "^5.33.13"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "26.6.2",
    "@types/tail": "^2.2.3",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "9.39.2",
    "fs-extra": "^11.4.0",
    "globals": "^17.12.0",
    "nodemon": "^3.1.14",
    "ora": "^9.4.1",
    "prettier": "^3.9.8",
    "rimraf": "^6.1.3",
    "tail": "^2.2.6",
    "tsx": "^4.23.15",
    "tsyringe": "^4.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "updates": "^19.0.0",
    "vitest": "^5.0.1"
  },
  "author": "seydx (https://github.com/cameraui/camera.ui)",
  "bugs": {
    "url": "https://github.com/cameraui/camera.ui/issues"
  },
  "homepage": "https://github.com/cameraui/camera.ui#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cameraui/camera.ui.git"
  },
  "keywords": [
    "camera.ui",
    "camera",
    "nvr",
    "surveillance",
    "homekit",
    "streaming",
    "webrtc",
    "motion detection",
    "object detection",
    "launcher"
  ]
}
